# ============================================================================
# MicroStream Backend Configuration
# ============================================================================

PORT=4000
NODE_ENV=development

# Adapter Selection Modes ('mock' or 'live')
# Default is 'mock' for local development without external dependencies
LEDGER_ADAPTER_MODE=mock
PAYOUT_ADAPTER_MODE=mock
PAYMENT_ADAPTER_MODE=mock

# Database Configuration (PostgreSQL / YugabyteDB)
# When unavailable, backend automatically uses seed-initialized in-memory store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microstream

# Hyperledger Fabric / Drunix Network Configuration (Used when LEDGER_ADAPTER_MODE=live)
FABRIC_GATEWAY_PEER_ENDPOINT=localhost:7051
FABRIC_CHANNEL_NAME=microstream-channel
FABRIC_CHAINCODE_NAME=microstream
FABRIC_MSP_ID=Org1MSP

# UPI AutoPay Configuration (Used when PAYMENT_ADAPTER_MODE=live)
# IMPORTANT: In this prototype, mock mode is enforced to prevent any real UPI debits.
UPI_AUTOPAY_ENV=mock
UPI_AUTOPAY_MAX_RETRIES=3
UPI_AUTOPAY_MERCHANT_VPA=microstream@icici
